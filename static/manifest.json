{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "__MSG_extShortName__",
  "version": "0.0.0",
  "description": "__MSG_extDescription__",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16-dark.png",
    "32": "icons/icon32-dark.png",
    "48": "icons/icon48-dark.png",
    "128": "icons/icon128-dark.png"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "icons/icon16-outline.png",
      "32": "icons/icon32-outline.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "sidepanel.html"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "permissions": [
    "sidePanel",
    "offscreen",
    "tabs",
    "tabGroups",
    "storage",
    "alarms",
    "history",
    "bookmarks",
    "downloads",
    "scripting",
    "sessions",
    "search",
    "contextMenus",
    "favicon",
    "declarativeNetRequestWithHostAccess",
    "management",
    "contentSettings",
    "browsingData",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+A"
      },
      "description": "__MSG_cmdOpenSidebar__"
    },
    "open-command-bar": {
      "suggested_key": {
        "default": "Alt+T",
        "mac": "MacCtrl+T"
      },
      "description": "__MSG_cmdOpenCommandBar__"
    },
    "toggle-sidebar": {
      "suggested_key": {
        "default": "Alt+S",
        "mac": "MacCtrl+S"
      },
      "description": "__MSG_cmdToggleSidebar__"
    }
  },
  "default_locale": "en",
  "optional_permissions": [
    "userScripts",
    "cookies"
  ]
}
