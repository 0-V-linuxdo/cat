{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["chrome", "bun"],
    "baseUrl": ".",
    "paths": {
      "@utils/*": ["src/utils/*"],
      "@src/*": ["src/*"],
      "@components/*": ["src/components/*"],
      "@api/*": ["src/api/*"],
      "@plugins/*": ["src/plugins/*"],
      "~plugins": ["src/globals.d.ts"]
    }
  },
  "include": ["src", "build.ts", "scripts", "tests"]
}
